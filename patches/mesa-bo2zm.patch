+DEBUG_GET_ONCE_BOOL_OPTION(nvk_switch_draw, "NVK_SWITCH_DRAW", true)
+
+static int32_t
+nvk_sw_read_env(void)
+{
+   const int32_t env = debug_get_option_nvk_switch_draw() ? 1 : 0;
+   uint64_t frequency = 0;
+#if defined(__aarch64__)
+   __asm__ volatile("mrs %0, cntfrq_el0" : "=r"(frequency));
+#endif
+   p_atomic_set(&nvk_switch_draw.ticks_per_second, frequency);
+   if (p_atomic_xchg(&nvk_switch_draw.env, env) < 0) {
+      fprintf(stderr, "[nvk] c186 per-part draw measurement and improvements: %s "
+              "(clock %llu Hz)\n",
+              env ? "available (NVK_SWITCH_DRAW)"
+                      : "disabled by NVK_SWITCH_DRAW",
+              (unsigned long long)frequency);
+   }
+   return env;
+}
+
+/* In vkBeginCommandBuffer, after the reset memset: what is measured and which
+ * improvements take the new path in this buffer. Whatever the app changes afterwards
+ * applies to the next buffer.
+ */
+void
+nvk_sw_begin_buffer(struct nvk_cmd_buffer *cmd)
+{
+   struct nvk_sw_cmd *sw = &cmd->state.sw;
+   int32_t env = p_atomic_read_relaxed(&nvk_switch_draw.env);
+   if (unlikely(env < 0))
+      env = nvk_sw_read_env();
+
+   const int32_t measure = p_atomic_read_relaxed(&nvk_switch_draw.measure);
+   sw->measure_mask =
+      (env > 0 && measure > 0 && util_is_power_of_two_nonzero((unsigned)measure))
+         ? (uint32_t)measure - 1 : UINT32_MAX;
+   sw->measure_misses = sw->measure_mask != UINT32_MAX &&
+                      p_atomic_read_relaxed(&nvk_switch_draw.measure_misses) > 0;
+   sw->active_mask = 0;
+   if (env > 0) {
+      for (uint32_t m = 0; m < NVK_SW_IMPROVEMENTS; m++) {
+         const struct nvk_sw_improvement_state *e = &nvk_switch_draw.improvements[m];
+         if (p_atomic_read_relaxed(&e->requested) != 0 &&
+             p_atomic_read_relaxed(&e->disabled) == 0)
+            sw->active_mask |= 1u << m;
+      }
+   }
+   /* p06: the runtime's prefetch when binding pipelines goes with NVK's */
+   p_atomic_set(&vk_switch_prefetch,
+                (int32_t)((sw->active_mask >> NVK_SW_M_PREFETCH) & 1));
+}
+
+static void
+nvk_sw_accumulate_u64(uint64_t *total, uint64_t *local)
+{
+   if (*local != 0) {
+      p_atomic_add(total, *local);
+      *local = 0;
+   }
+}
+
+void
+nvk_sw_accumulate(struct nvk_cmd_buffer *cmd)
+{
+   struct nvk_sw_cmd *sw = &cmd->state.sw;
+   for (uint32_t i = 0; i < NVK_SW_PARTS; i++) {
+      nvk_sw_accumulate_u64(&nvk_switch_draw.parts[i].times, &sw->parts[i].times);
+      nvk_sw_accumulate_u64(&nvk_switch_draw.parts[i].ticks, &sw->parts[i].ticks);
+   }
+   for (uint32_t i = 0; i < NVK_SW_COUNTS; i++)
+      nvk_sw_accumulate_u64(&nvk_switch_draw.counts[i], &sw->counts[i]);
+   for (uint32_t m = 0; m < NVK_SW_IMPROVEMENTS; m++) {
+      struct nvk_sw_improvement_state *e = &nvk_switch_draw.improvements[m];
+      nvk_sw_accumulate_u64(&e->uses, &sw->uses[m]);
+      nvk_sw_accumulate_u64(&e->validated, &sw->validated[m]);
+      nvk_sw_accumulate_u64(&e->differences, &sw->differences[m]);
+      nvk_sw_accumulate_u64(&e->unchecked, &sw->unchecked[m]);
