+   struct vk_sample_locations_state sl_before, sl_fast;
+   memset(&vi_before, 0, sizeof(vi_before));
+   memset(&sl_before, 0, sizeof(sl_before));
+   if (dst->vi != NULL)
+      vi_before = *dst->vi;
+   if (dst->ms.sample_locations != NULL)
+      sl_before = *dst->ms.sample_locations;
+
+   vk_bo2_copy_by_hashes(dst, src);
+   const struct vk_dynamic_graphics_state fast = *dst;
+   vi_fast = dst->vi != NULL ? *dst->vi : vi_before;
+   sl_fast = dst->ms.sample_locations != NULL ? *dst->ms.sample_locations : sl_before;
+
+   *dst = before;
+   if (dst->vi != NULL)
+      *dst->vi = vi_before;
+   if (dst->ms.sample_locations != NULL)
+      *dst->ms.sample_locations = sl_before;
+   vk_dynamic_graphics_state_copy(dst, src);
