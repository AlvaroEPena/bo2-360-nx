+void
+nvk_switch_set4_accumulate(struct nvk_cmd_buffer *cmd)
+{
+   struct nvk_switch_set4_counts *c = &cmd->state.set4;
+   struct nvk_switch_set4_counts *t = &nvk_switch_set4.total;
+
+   if (c->delta_binds)
+      p_atomic_add(&t->delta_binds, c->delta_binds);
+   if (c->full_binds)
+      p_atomic_add(&t->full_binds, c->full_binds);
+   if (c->root_writes)
+      p_atomic_add(&t->root_writes, c->root_writes);
+   if (c->root_dwords)
+      p_atomic_add(&t->root_dwords, c->root_dwords);
+   if (c->cbufs_dirty)
+      p_atomic_add(&t->cbufs_dirty, c->cbufs_dirty);
+   if (c->cbufs_saved)
+      p_atomic_add(&t->cbufs_saved, c->cbufs_saved);
+   if (c->draws)
+      p_atomic_add(&t->draws, c->draws);
+   if (c->checks)
+      p_atomic_add(&t->checks, c->checks);
+   if (c->differences)
+      p_atomic_add(&t->differences, c->differences);
+   memset(c, 0, sizeof(*c));
+}
