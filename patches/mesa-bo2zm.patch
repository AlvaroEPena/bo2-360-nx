+         n_copy++;
+      }
+      i++;
+   }
+   if (n_copy)
+      vk_bo2_copy_bits(dst, src, to_copy);
+
+   /* The usual copy's last step, for every bit of src (the skipped ones are
+    * already set in dst: nothing changes for them).
+    */
+   for (uint32_t w = 0; w < ARRAY_SIZE(dst->dirty); w++) {
+      dst->dirty[w] |= src->set[w] & ~dst->set[w];
+      dst->set[w] |= src->set[w];
+   }
+   dst->rasterization_order_access |= src->rasterization_order_access;
+
+   i = 0;
+   BITSET_FOREACH_SET(b, src->set, MESA_VK_DYNAMIC_GRAPHICS_STATE_ENUM_MAX) {
+      if (BITSET_TEST(to_copy, b)) {
+         dst->bo2_hash[b] = src->bo2_hash[i];
+         BITSET_SET(dst->bo2_known, b);
+      }
+      i++;
+   }
+   p_atomic_add(&vk_bo2_copy_state.bits_copied, n_copy);
+   p_atomic_add(&vk_bo2_copy_state.bits_skipped, n_skip);
+}
