+/* Sends to the root table only the words dynamic_buffers[k][d], with d from
+ * begin to fin - 1, that change or have not been sent yet in this command
+ * buffer, with one command per array k that covers them. Returns in *changed
+ * the descriptors whose value changed (so that only their cbufs get dirtied).
+ */
+static void
+nvk_switch_set4_write_root(struct nvk_cmd_buffer *cmd,
+                              struct nvk_descriptor_state *desc,
+                              uint32_t dynamic_buffers[4][NVK_MAX_DYNAMIC_BUFFERS],
+                              uint32_t begin, uint32_t fin,
+                              uint64_t *changed)
+{
+   const struct nvk_root_descriptor_table *root =
+      (const struct nvk_root_descriptor_table *)desc->root;
+   uint64_t different = 0;
+
+   for (uint32_t k = 0; k < 4; k++) {
+      uint32_t first = fin, last = begin;
+      for (uint32_t d = begin; d < fin; d++) {
+         const bool differs =
+            root->dynamic_buffers[k][d] != dynamic_buffers[k][d];
+         if (differs)
+            different |= BITFIELD64_BIT(d);
+         if (differs || !(desc->dyn_synced & BITFIELD64_BIT(d))) {
+            if (first == fin)
+               first = d;
+            last = d;
+         }
+      }
+      if (first < fin) {
+         const uint32_t n = last - first + 1;
+         nvk_descriptor_state_set_root_array(cmd, desc, dynamic_buffers[k],
+                                             first, n,
+                                             &dynamic_buffers[k][first]);
+         cmd->state.set4.root_writes++;
+         cmd->state.set4.root_dwords += n;
+      }
    }
+   if (fin > begin) {
+      desc->dyn_synced |= BITFIELD64_RANGE(begin, fin - begin);
+      cmd->state.set4.delta_binds++;
+   }
+   *changed = different;
+}
+
+/* The usual path, as is, recording that what was sent is up to date. */
+static void
+nvk_switch_set4_write_full_root(struct nvk_cmd_buffer *cmd,
+                                       struct nvk_descriptor_state *desc,
+                                       uint32_t dynamic_buffers[4][NVK_MAX_DYNAMIC_BUFFERS],
+                                       uint32_t begin, uint32_t fin)
+{
+   for (int i = 0; i < 4; i++)
+      nvk_descriptor_state_set_root_array(cmd, desc, dynamic_buffers[i],
+                                          begin, fin - begin,
+                                          &dynamic_buffers[i][begin]);
+   if (desc->flush_root != NULL && fin > begin)
+      desc->dyn_synced |= BITFIELD64_RANGE(begin, fin - begin);
+   if (desc == &cmd->state.gfx.descriptors && fin > begin)
+      cmd->state.set4.full_binds++;
 }
 
+/* Like nvk_cmd_dirty_cbufs_for_descriptors, but the DYNAMIC_UBO cbufs are only
+ * dirtied if the descriptor they read changed value. The DESC_SET and
+ * UBO_DESC ones of the bound sets are always dirtied, as before.
+ */
+static void
+nvk_switch_set4_dirty(struct nvk_cmd_buffer *cmd,
+                         VkShaderStageFlags stages,
+                         uint32_t sets_start, uint32_t sets_end,
+                         const uint8_t *dyn_start,
+                         uint64_t changed)
+{
+   if (!(stages & NVK_VK_GRAPHICS_STAGE_BITS))
+      return;
+
+   /* bo2-zm-nx: NVK_SW_M_CBUFS: something gets dirtied, and the cached groups of
+    * these stages (nvk_sw_stage_groups)
+    */
+   cmd->state.gfx.sw_cbufs_clean = false;
+   const bool sw_cbufs = nvk_sw_enabled(cmd, NVK_SW_M_CBUFS);
+   bool sw_check = false;
+   if (sw_cbufs) {
+      cmd->state.sw.uses[NVK_SW_M_CBUFS]++;
+      sw_check = nvk_sw_due_check(cmd, NVK_SW_M_CBUFS);
+   }
+   const uint32_t groups =
+      nvk_sw_stage_groups(cmd, stages, sw_cbufs, sw_check);
+
+   u_foreach_bit(g, groups) {
+      struct nvk_cbuf_group *group = &cmd->state.gfx.cbuf_groups[g];
+
+      unsigned sets_mask = group->desc_slots;
+      while (sets_mask) {
+         const unsigned i = u_bit_scan(&sets_mask);
+         const struct nvk_cbuf *cbuf = &group->cbufs[i];
+         if (cbuf->desc_set >= sets_start && cbuf->desc_set < sets_end)
+            group->dirty |= BITFIELD_BIT(i);
+      }
+
+      unsigned dynamics = group->dyn_ubo_slots;
+      while (dynamics) {
+         const unsigned i = u_bit_scan(&dynamics);
+         const struct nvk_cbuf *cbuf = &group->cbufs[i];
+         if (cbuf->desc_set < sets_start || cbuf->desc_set >= sets_end)
+            continue;
+
+         const uint32_t d = dyn_start[cbuf->desc_set] + cbuf->dynamic_idx;
+         if (d >= NVK_MAX_DYNAMIC_BUFFERS || (changed & BITFIELD64_BIT(d))) {
+            group->dirty |= BITFIELD_BIT(i);
+            cmd->state.set4.cbufs_dirty++;
+         } else {
+            cmd->state.set4.cbufs_saved++;
+         }
+      }
+   }
+}
