+/* The guard of improvement m saw a difference. The caller has already kept
+ * the result of the usual path. It is turned off for the session (the
+ * following buffers do not enable it; this one stops using it right away).
+ */
+void
+nvk_sw_difference(struct nvk_cmd_buffer *cmd, enum nvk_sw_improvement m,
+                  const char *what)
+{
+   cmd->state.sw.differences[m]++;
+   cmd->state.sw.active_mask &= ~(1u << m);
+   if (p_atomic_xchg(&nvk_switch_draw.improvements[m].disabled, 1) == 0) {
+      fprintf(stderr, "[nvk] c186: MISMATCH in improvement %u (%s): this case "
+              "takes the usual path and the improvement is turned off for the rest "
+              "of the session\n", (unsigned)m, what);
+   }
+}
