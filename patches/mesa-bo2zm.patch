+      fprintf(stderr, "[vk] bo2-zm-nx: state copy by hashes: MISMATCH with the usual copy "
+                      "(first differing byte %zu of %zu; %s); off for the session\n",
+              k, values_size, k < values_size ? "values or bits" : "vertex input or sample locations");
