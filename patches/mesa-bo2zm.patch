+   const size_t values_size = offsetof(struct vk_dynamic_graphics_state, bo2_known);
+   bool equal = memcmp(&fast, dst, values_size) == 0;
+   if (equal && dst->vi != NULL)
+      equal = memcmp(&vi_fast, dst->vi, sizeof(vi_fast)) == 0;
+   if (equal && dst->ms.sample_locations != NULL)
+      equal = memcmp(&sl_fast, dst->ms.sample_locations, sizeof(sl_fast)) == 0;
+   p_atomic_inc(&vk_bo2_copy_state.checked);
+   if (equal) {
+      /* Same values: the fingerprint path's knowledge holds. */
+      memcpy(dst->bo2_known, fast.bo2_known, sizeof(dst->bo2_known));
+      memcpy(dst->bo2_hash, fast.bo2_hash, sizeof(dst->bo2_hash));
+      return;
+   }
+   /* The usual result stays and nothing known is trusted any more. */
+   BITSET_ZERO(dst->bo2_known);
