+/* --- bo2-zm-nx: binding a pipeline copies only the state groups that differ -------------------------------------
+ *
+ * Measured on the console in BO2: every vkCmdBindPipeline spent
+ * 1.77 us in vk_dynamic_graphics_state_copy, walking every group of the
+ * pipeline's fixed state field by field, while on average only ~1.4 state bits
+ * really changed and 27 % of the copies changed nothing.
+ *
+ * Each pipeline now carries one 64-bit fingerprint per bit of its fixed state
+ * (vk_bo2_hash_state, at creation): the XXH64 of exactly what the usual
+ * copy writes for that bit, obtained by running the usual copy for that bit
+ * alone into a zeroed state, plus the counts that size the copied arrays
+ * (viewports, scissors, color attachments, vertex bindings). The command
+ * buffer remembers, per bit, the fingerprint of the pipeline whose copy last
+ * wrote it, and forgets it as soon as anything else writes those values. A bit
+ * whose fingerprint matches holds the same values already, so the usual copy
+ * would do nothing for it: it is skipped. The rest go through the usual copy
+ * (the same body, restricted to those bits).
+ *
+ * SELF-CHECKING GUARD: the first 20,000 binds and then 1 in 1,024 run both
+ * paths from the same starting state and compare the whole result (values,
+ * set and dirty bits, vertex input and sample locations). On a difference the
+ * usual result stays, MISMATCH on stderr, and the path is off for the
+ * session (off, which the app forwards to its log).
+ */
+struct vk_bo2_copy_state vk_bo2_copy_state = {
+   .version = 1,
+};
+
+static uint64_t
+vk_bo2_counts_hash(const struct vk_dynamic_graphics_state *src)
+{
+   const uint32_t counts[4] = {
+      src->vp.viewport_count, src->vp.scissor_count,
+      src->cb.attachment_count, src->vi_bindings_valid,
+   };
+   return XXH64(counts, sizeof(counts), 0x42324f32u);
+}
+
+void
+vk_bo2_hash_state(struct vk_dynamic_graphics_state *dyn)
+{
+   struct vk_dynamic_graphics_state s;
+   struct vk_vertex_input_state vi;
+   struct vk_sample_locations_state sl;
+   const uint64_t counts = vk_bo2_counts_hash(dyn);
+   unsigned b;
+   uint32_t i = 0;
+
+   dyn->bo2_ready = false;
+   if (dyn->vi == NULL || dyn->ms.sample_locations == NULL)
+      return;
+   BITSET_FOREACH_SET(b, dyn->set, MESA_VK_DYNAMIC_GRAPHICS_STATE_ENUM_MAX) {
+      BITSET_DECLARE(only, MESA_VK_DYNAMIC_GRAPHICS_STATE_ENUM_MAX);
+      BITSET_ZERO(only);
+      BITSET_SET(only, b);
+      memset(&s, 0, sizeof(s));
+      memset(&vi, 0, sizeof(vi));
+      memset(&sl, 0, sizeof(sl));
+      s.vi = &vi;
+      s.ms.sample_locations = &sl;
+      vk_bo2_copy_bits(&s, dyn, only);
+      s.vi = NULL;
+      s.ms.sample_locations = NULL;
+      BITSET_ZERO(s.set);
+      BITSET_ZERO(s.dirty);
+      uint64_t h = XXH64(&s, offsetof(struct vk_dynamic_graphics_state, bo2_known),
+                         counts ^ ((uint64_t)b * 0x9E3779B97F4A7C15ull));
+      h = XXH64(&vi, sizeof(vi), h);
