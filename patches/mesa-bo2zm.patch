+#ifdef HAVE_SWITCH_PLATFORM
+/* bo2-zm-nx: per-part measurement of the draw and exact improvements
+ * (nvk_switch_draw, NVK_SWITCH_DRAW).
+ *
+ * The thread that records the draws can spend several microseconds per draw
+ * inside NVK (the renderer's "C6 substages" line shows Draw, BindPipeline and
+ * set 4 apart), on the game's bottleneck. Before optimizing blindly, it is
+ * measured inside NVK:
+ *
+ * - parts: CNTPCT_EL0 ticks (19.2 MHz: 52 ns per tick; with thousands of
+ * samples the average is unbiased) of each piece of vkCmdDraw*,
+ * vkCmdBindPipeline and vkCmdBindDescriptorSets, 1 of every N calls (the app
+ * sets N in measure; 0 = not measured and the cost is one branch per call);
+ * - counts: dirty dynamic bits per draw, dirty shaders, rebound
+ * cbufs, dwords per draw, pipeline state copies that changed
+ * nothing, root table uploads and new pushbuf chunks;
+ * - measure_misses: in the measured ones, before the pipeline copy and the shader
+ * flush all their data is read and that time is counted apart (the TOUCH parts).
+ *
+ * The improvements p02..p06 also use this structure: each has its requested
+ * (the app), its disabled (its guard) and its counts. They are all exact: they leave
+ * the same commands with the same data in the pushbuf. Each has a
+ * self-checking guard (the first NVK_SW_TO_CHECK uses of the
+ * process and then 1 of every NVK_SW_EVERY): it takes the usual path,
+ * compares it with the new one and, if they differ, keeps the usual one, reports it on
+ * stderr and turns that improvement off for the rest of the session.
+ */
+struct nvk_switch_draw nvk_switch_draw = {
+   .version = 1,
+   .measure = 0,
+   .measure_misses = 0,
+   .env = -1,
+   .improvements = {
+      [NVK_SW_M_EMIT] = { .requested = -1 },
+      [NVK_SW_M_CBUFS] = { .requested = -1 },
+      [NVK_SW_M_DYNAMIC] = { .requested = -1 },
+      [NVK_SW_M_SET4_FAST] = { .requested = -1 },
+      [NVK_SW_M_PREFETCH] = { .requested = -1 },
+   },
+};
